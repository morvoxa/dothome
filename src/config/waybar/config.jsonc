{
  "layer": "top",
  "position": "top",
  "height": 34,

  "modules-left": [],
  "modules-center": ["hyprland/workspaces","clock"],
  "modules-right": [],

  "hyprland/workspaces": {
    "show-special": false,
    "all-outputs": true,
    "format": "{name}",
    "move-to-monitor": true,
  },

  "clock": {
    "format": "{:%H:%M}"
  },

  "network": {
    "format-wifi": "  {essid}",
    "format-ethernet": "    Connected",
    "format-disconnected": "    Disconnected",
    "tooltip-format": "{ipaddr} | {bandwidthUpBytes}up {bandwidthDownBytes}down",
    "max-length": 30
  }
}

