#
# Mako Configuration - Dark Green Capsule Theme (Green Border, 4s Timeout)
#

# Global & Position Settings
anchor=top-right
width=350
height=150
margin=15
padding=12,18
border-size=2

# Auto-close timeout (4000 milliseconds = 4 seconds)
default-timeout=4000

# Capsule & Rounded Corner Styling 
border-radius=20

# Dark Green Color Palette with a Solid Green Border
background-color=#0f1c14ff
text-color=#d8f3dcff
border-color=#52b788ff

# Progress Bar & Icons
progress-color=over #52b788ff
icons=1
max-icon-size=32
icon-location=left

# Typography
font=Sans 10
markup=1
format=<b>%s</b>\n%b

# Actions & History
actions=1
history=1
max-history=5

# Critical Notification Urgency Overrides (Optional)
[urgency=high]
border-color=#d8572aff
background-color=#1c120fff
text-color=#f7ede2ff
default-timeout=0

[urgency=low]
background-color=#0f1c14cc
text-color=#95d5b2ff
border-color=#2d6a4fff
default-timeout=4000
